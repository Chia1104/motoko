{
  "name": "@chia1104/motoko-client",
  "version": "0.1.0",
  "description": "Motoko from the browser: a session's view folded from its events and resumed by cursor, and the calls, over a WebSocket to a Durable Object or HTTP and server-sent events to a Node server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@chia1104/motoko-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@chia1104/motoko-source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@chia1104/motoko-wire": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chia1104/motoko-core": "workspace:*",
    "@chia1104/motoko-node": "workspace:*",
    "@earendil-works/chord": "catalog:pi",
    "@earendil-works/pi-ai": "catalog:pi",
    "@earendil-works/pi-durable": "catalog:pi",
    "@earendil-works/pi-schema": "catalog:pi",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
